---
import { Icon } from "astro-icon/components";
import LinkButton from "./LinkButton.astro";
import Badge from "../UI/Badge.astro";

interface Props {
    title: string;
    description: string;
    image?: string;
    tags?: Array<{
        name: string;
        class: string;
        icon: string;
    }>;
    link?: string;
    github?: string;
    upcoming?: boolean;
}

const {
    image,
    title,
    description,
    tags = [],
    link,
    github,
    upcoming = false,
} = Astro.props;

// Shown when a finished project has no image, or its image fails to load.
// Upcoming projects without an image show no picture at all.
// Put default-project.jpg in public/images/ (or change this path).
const DEFAULT_IMAGE = "/images/default-project.jpg";

// Keep cards short: show the first few tags, the rest sit behind a clickable "+N"
const MAX_TAGS = 5;
const shownTags = tags.slice(0, MAX_TAGS);
const hiddenTags = tags.slice(MAX_TAGS);
---

<article
    class:list={[
        "group flex h-full flex-col overflow-hidden rounded-2xl border bg-gray-900/50 transition duration-300",
        upcoming
            ? "border-dashed border-white/20"
            : "border-white/10 hover:border-primary/50",
    ]}
>
    {
        (!upcoming || image) && (
            <div class="overflow-clip">
                <img
                    alt={title}
                    class:list={[
                        "aspect-video w-full object-cover transition duration-500 group-hover:scale-105",
                        image ? "object-top" : "object-center",
                    ]}
                    loading="lazy"
                    src={image || DEFAULT_IMAGE}
                    onerror={`this.onerror=null;this.src='${DEFAULT_IMAGE}';this.classList.remove('object-top');this.classList.add('object-center')`}
                />
            </div>
        )
    }

    <div class="flex flex-1 flex-col gap-3 p-5">
        <h3
            class="text-lg font-bold leading-snug text-white transition-colors duration-300 group-hover:text-primary"
        >
            {title}
        </h3>

        {
            shownTags.length > 0 && (
                <ul class="flex flex-wrap gap-1.5">
                    {shownTags.map((tag) => (
                        <li>
                            <Badge
                                class:list={[
                                    "flex items-center gap-x-1.5 text-[11px] py-1 px-2 border-white/5",
                                    tag.class,
                                ]}
                            >
                                <Icon name={tag.icon} class="size-3.5" />
                                {tag.name}
                            </Badge>
                        </li>
                    ))}
                    {hiddenTags.map((tag) => (
                        <li data-extra-tag class="hidden">
                            <Badge
                                class:list={[
                                    "flex items-center gap-x-1.5 text-[11px] py-1 px-2 border-white/5",
                                    tag.class,
                                ]}
                            >
                                <Icon name={tag.icon} class="size-3.5" />
                                {tag.name}
                            </Badge>
                        </li>
                    ))}
                    {hiddenTags.length > 0 && (
                        <li>
                            <button
                                type="button"
                                data-tags-toggle
                                data-count={hiddenTags.length}
                                aria-expanded="false"
                                aria-label="Show or hide more technologies"
                                class="inline-flex cursor-pointer items-center rounded-full border border-white/10 bg-white/5 px-2 py-1 text-[11px] text-gray-300 transition hover:bg-white/10 hover:text-white focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-primary"
                            >
                                +{hiddenTags.length}
                            </button>
                        </li>
                    )}
                </ul>
            )
        }

        <p class="line-clamp-5 text-sm font-light leading-relaxed text-gray-300">
            {description}
        </p>

        {
            (github || link) && (
                <footer class="mt-auto flex flex-wrap items-center gap-2 pt-2">
                    {github && (
                        <LinkButton href={github} size="sm">
                            <Icon name="lucide:github" class="size-4" />
                            Source Code
                        </LinkButton>
                    )}
                    {link && (
                        <LinkButton href={link} size="sm">
                            <Icon name="lucide:external-link" class="size-4" />
                            Live Demo
                        </LinkButton>
                    )}
                </footer>
            )
        }
    </div>
</article>

<script>
    // One listener for every card on the page
    document.addEventListener("click", (event) => {
        const toggle = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-tags-toggle]",
        );
        if (!toggle) return;

        const list = toggle.closest("ul");
        if (!list) return;

        const expanded = toggle.getAttribute("aria-expanded") === "true";

        list.querySelectorAll("[data-extra-tag]").forEach((el) =>
            el.classList.toggle("hidden", expanded),
        );
        toggle.setAttribute("aria-expanded", String(!expanded));
        toggle.textContent = expanded ? `+${toggle.dataset.count}` : "Show less";
    });
</script>