---
interface Props {
    href: string;
    size?: "sm" | "md";
}

const { href, size = "md" } = Astro.props;
const sizeClasses = size === "sm" ? "px-2.5 py-1.5 text-sm" : "px-3 py-2 text-base";
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    role="link"
    class:list={[
        "inline-flex items-center justify-center gap-2 space-x-2 text-white transition bg-gray-800 border border-gray-600 focus-within:ring-primary focus-within:ring-offset-2 hover:bg-gray-700 hover:border-primary/50 group max-w-fit rounded-xl active:bg-gray-900 focus:outline-hidden focus:ring-2 focus:ring-offset-2",
        sizeClasses,
    ]}
>
    <slot />
</a>