
---
import "../../styles/stars.css";
---

<div class="fixed inset-0 pointer-events-none -z-10 bg-[#010208]">
  <div id="nebula"></div>
  <div id="milky-way"></div>
  <div id="stars"></div>
  <div id="stars2"></div>
  <div id="stars3"></div>

  <div id="shooting-stars" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <script>
        const shootingStars = document.querySelectorAll<HTMLSpanElement>(
            "#shooting-stars span"
        );

        shootingStars.forEach((star) => {
            function randomizeStar() {
                const startX = Math.random() * 80;
                const startY = Math.random() * 45;

                star.style.left = `${startX}%`;
                star.style.top = `${startY}%`;
            }

            randomizeStar();

            star.addEventListener("animationiteration", randomizeStar);
        });
    </script>
</div>
