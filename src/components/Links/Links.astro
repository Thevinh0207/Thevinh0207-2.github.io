---
import { Icon } from "astro-icon/components";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;

const links = [
    {
        name: "LinkedIn",
        icon: "lucide:linkedin",
        href: "https://linkedin.com/in/the-vinh-vuong-6a54533a7/",
        external: true,
    },
    {
        name: "GitHub",
        icon: "lucide:github",
        href: "https://github.com/Thevinh0207",
        external: true,
    },
    {
        name: "Email",
        icon: "lucide:mail",
        href: "mailto:vuongthevinh07@gmail.com",
        external: false,
    },
];
---

<div class:list={["flex items-center gap-4 mb-6", className]}>
    {
        links.map(({ name, icon, href, external }) => (
            <a
                href={href}
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                aria-label={name}
                class="inline-flex size-11 md:size-12 items-center justify-center rounded-full border border-white/10 bg-gray-900/50 text-[#bc95ff] backdrop-blur-md transition-all duration-300 hover:scale-110 hover:border-purple-400/60 hover:bg-gray-800/70 hover:text-white focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-primary"
            >
                <Icon name={icon} class="size-5 md:size-6" />
            </a>
        ))
    }
</div>